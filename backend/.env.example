# FastAPI Guard tuning
# Leave TRUSTED_PROXIES unset to auto-detect the container gateway at startup.
# Set it explicitly only if you need to pin a specific proxy IP or CIDR.
# TRUSTED_PROXIES=172.17.0.1
AUTO_BAN_THRESHOLD=10
AUTO_BAN_DURATION=3600
ENABLE_PENETRATION_DETECTION=true
ENABLE_RATE_LIMITING=true

